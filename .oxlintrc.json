{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx-a11y", "unicorn", "typescript", "oxc", "nextjs"],
  "categories": { "correctness": "error" },
  "ignorePatterns": [
    ".next",
    "node_modules",
    "playwright-report",
    "test-results",
    "next-env.d.ts"
  ]
}
