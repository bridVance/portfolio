{
  "name": "portfolio-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "analyze": "ANALYZE=true next build",
    "e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "assert:bundle": "node scripts/assert-bundle.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run assert:bundle && npm run e2e",
    "lhci": "lhci autorun",
    "e2e:visual": "cross-env VISUAL=1 playwright test e2e/home.visual.spec.ts --project=chromium-desktop"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "clsx": "^2.1.1",
    "liquid-glass-js": "^0.1.0",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^15.5.25",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.27",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
